        },
        "status": {
          "enum": [
            "ISSUED",
            "RESERVED",
            "CONSUMED",
            "INVALIDATED"
          ]
        },
        "scope": {
          "const": "COMMIT"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "expected_parent_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "expected_tree_oid": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "schema_version",
        "token_id",
        "work_item",
        "gate_id",
        "issuer",
        "issued_utc",
        "status",
        "scope",
        "candidate_id",
        "manifest_hash",
        "repository_id",
        "branch",
        "expected_parent_sha",
        "expected_tree_oid",
        "job_id"
      ]
    },
