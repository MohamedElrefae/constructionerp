+def setup_website_branding():
+    """Set Construction ERP branding on Website Settings and System Settings."""
+    try:
+        # Website Settings
+        if frappe.db.exists("DocType", "Website Settings"):
+            ws = frappe.get_doc("Website Settings")
+            changed = False
+            if getattr(ws, "app_name", None) != "Construction ERP":
+                ws.app_name = "Construction ERP"
+                changed = True
+            logo_path = "/assets/construction/images/construction_logo.svg"
+            if getattr(ws, "app_logo", None) != logo_path:
+                ws.app_logo = logo_path
+                changed = True
+            if getattr(ws, "brand_html", None) != "Construction ERP":
+                ws.brand_html = "Construction ERP"
+                changed = True
+            if changed:
+                ws.save(ignore_permissions=True)
+
+        # System Settings
+        if frappe.db.exists("DocType", "System Settings"):
+            ss = frappe.get_doc("System Settings")
+            if getattr(ss, "app_name", None) != "Construction ERP":
+                ss.app_name = "Construction ERP"
+                ss.save(ignore_permissions=True)
+
+        # Navbar Settings
+        if frappe.db.exists("DocType", "Navbar Settings"):
+            ns = frappe.get_doc("Navbar Settings")
+            logo_path = "/assets/construction/images/construction_logo.svg"
+            if getattr(ns, "app_logo", None) != logo_path:
+                ns.app_logo = logo_path
+                ns.save(ignore_permissions=True)
+    except Exception:
+        # Non-fatal: branding can be set manually if this fails
+        pass
+
+
