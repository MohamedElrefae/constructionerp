# Production Procfile — isolated bench operating profile
# One process per role; no shared ports with development bench.
web: /home/frappe/frappe-bench/env/bin/gunicorn -w 4 -b 127.0.0.1:18000 --timeout 120 --graceful-timeout 30 frappe.app:application --preload
worker_default: /home/frappe/frappe-bench/env/bin/bench worker --queue default --site all
worker_short: /home/frappe/frappe-bench/env/bin/bench worker --queue short,timeouts --site all
worker_long: /home/frappe/frappe-bench/env/bin/bench worker --queue long,timeouts --site all
scheduler: /home/frappe/frappe-bench/env/bin/bench schedule
socketio: /home/frappe/frappe-bench/env/bin/node socketio.js
