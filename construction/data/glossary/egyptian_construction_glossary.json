{
  "meta": {
    "name": "Egyptian Construction & Accounting Glossary",
    "version": "1.0",
    "date": "2026-08-22",
    "author": "Construction ERP localization review",
    "dialect": "Egyptian professional Arabic (MSA technical vocabulary, Egyptian construction practice)",
    "notes": [
      "Canonical source of truth for Arabic terminology in the Construction app and its ERPNext integration layer.",
      "Applied to existing DB rows via construction.patches.v8_3.fix_arabic_domain_terminology.",
      "Terms are region-specific to Egypt; Subcontractor family must NEVER use manufacturing phrasing (التصنيع بالعقد).",
      "Companion runtime seed: construction.data.translations.* (insert-only, non-destructive)."
    ]
  },
  "rules": [
    "Do not use 'التصنيع بالعقد' / 'مصنع بالعقد' anywhere. Construction subcontracting = مقاول الباطن / مقاولات الباطن.",
    "Do not use 'قيد دفع' for Payment Entry. Use the dual voucher 'سند قبض / سند صرف'.",
    "Do not use stock-market phrasing for construction retention. Retention = محتجزات ضمان.",
    "Keep DocType technical identifiers (BOQ Header, BOQ Item, Resource Price History) in English unless UI requires Arabic labels.",
    "Preserve placeholders {0}, {1}, %s and whitespace exactly when applying to messages."
  ],
  "terms": [
    {"en": "Subcontractor", "ar": "مقاول باطن", "category": "subcontracting", "notes": "Person/company hired under a subcontract."},
    {"en": "Subcontracting", "ar": "مقاولات الباطن", "category": "subcontracting", "notes": "The works/process of subcontracting."},
    {"en": "Subcontract", "ar": "عقد مقاولات باطن", "category": "subcontracting", "notes": "The subcontract agreement."},
    {"en": "Subcontract Order", "ar": "أمر مقاولات باطن", "category": "subcontracting", "notes": "Order issued to a subcontractor."},
    {"en": "Subcontracting Order", "ar": "أمر مقاولات باطن", "category": "subcontracting", "notes": "ERPNext manufacturing-side; pivoted to construction domain."},
    {"en": "Subcontracting Receipt", "ar": "إيصال استلام مقاولات باطن", "category": "subcontracting", "notes": "Receipt of subcontractor works/materials."},
    {"en": "Subcontracting Purchase Order", "ar": "أمر شراء مقاول باطن", "category": "subcontracting", "notes": "Purchase order to a subcontractor."},
    {"en": "Subcontracting Sales Order", "ar": "أمر بيع مقاول باطن", "category": "subcontracting", "notes": "Sales order to a subcontractor."},
    {"en": "Subcontracting BOM", "ar": "قائمة مواد مقاول الباطن", "category": "subcontracting", "notes": "Bill of materials for a subcontract."},
    {"en": "Subcontract BOM", "ar": "قائمة مواد مقاول الباطن", "category": "subcontracting", "notes": "Bill of materials for a subcontract."},
    {"en": "Subcontracting Settings", "ar": "إعدادات مقاولات الباطن", "category": "subcontracting", "notes": "Settings for subcontracting module."},
    {"en": "Subcontracting Inward", "ar": "استلام مقاولات الباطن", "category": "subcontracting", "notes": "Inward subcontract flows."},
    {"en": "Subcontracting Delivery", "ar": "تسليم مقاولات الباطن", "category": "subcontracting", "notes": "Delivery of subcontract works/materials."},
    {"en": "Is Subcontracted", "ar": "من الباطن", "category": "subcontracting", "notes": "Check: works executed via subcontract."},
    {"en": "Is Subcontracted Item", "ar": "بند منفذ من الباطن", "category": "subcontracting", "notes": "Item executed by subcontractor."},
    {"en": "Subcontracted Quantity", "ar": "الكمية المنفذة من الباطن", "category": "subcontracting", "notes": "Quantity executed under subcontract."},
    {"en": "Reserved Qty for Subcontract", "ar": "الكمية المحجوزة لمقاول الباطن", "category": "subcontracting", "notes": "Quantity reserved for a subcontractor."},
    {"en": "Subcontracting Conversion Factor", "ar": "معامل تحويل مقاولات الباطن", "category": "subcontracting", "notes": "Conversion factor in subcontract flows."},
    {"en": "Subcontracting Order Item", "ar": "بند أمر مقاولات باطن", "category": "subcontracting", "notes": "Line item on a subcontract order."},
    {"en": "Mobilization Cost", "ar": "تكلفة تجهيز الموقع", "category": "accounts", "notes": "Egyptian tender/prelims cost. Previously 'تكلفة التجهيز'."},
    {"en": "Retention", "ar": "محتجزات ضمان", "category": "accounts", "notes": "Never 'الاحتفاظ الأسهم' (stock-market). Construction retention of payments."},
    {"en": "Retention Money", "ar": "محتجزات ضمان", "category": "accounts", "notes": "Retained portion of certificate payment."},
    {"en": "Advance Payment", "ar": "دفعة مقدمة", "category": "accounts", "notes": "Advance payment to subcontractor/supplier."},
    {"en": "Advance", "ar": "دفعة مقدمة", "category": "accounts", "notes": "General advance."},
    {"en": "Payment Entry", "ar": "سند قبض / سند صرف", "category": "accounts", "notes": "Dual-purpose payment voucher. NOT 'قيد دفع'. Payment-type-specific labels require context but upstream renders the doctype globally."},
    {"en": "Journal Entry", "ar": "قيد يومية", "category": "accounts", "notes": "Standardize singular form. Standardize away 'قيد اليومية'."},
    {"en": "Progress Billing", "ar": "مستخلص جاري", "category": "accounts", "notes": "Interim payment certificate (Egyptian: مستخلص). Previously generic."},
    {"en": "Payment Certificate", "ar": "مستخلص", "category": "accounts", "notes": "Engineer's interim certificate."},
    {"en": "Overtime", "ar": "ساعات إضافية", "category": "labor", "notes": "Overtime hours. Avoid literal 'عمل إضافي' in timesheet context."},
    {"en": "Variation Order", "ar": "أمر تغيير", "category": "boq", "notes": "VO. Previously generic/absent."},
    {"en": "Bill of Quantities", "ar": "جدول الكميات", "category": "boq", "notes": "BOQ. Previously generic/absent."},
    {"en": "Handover", "ar": "التسليم الابتدائي", "category": "site", "notes": "Initial handover of works (Egyptian standard)."},
    {"en": "Voucher", "ar": "السند", "category": "accounts", "notes": "Accounting voucher. Keep definite article to match current catalog."},
    {"en": "Save and Submit", "ar": "حفظ وترحيل", "category": "core-actions", "notes": "Critical override, must not revert to 'حفظ وتقديم'."},
    {"en": "Submit", "ar": "ترحيل", "category": "core-actions", "notes": "Accounting submit. NOT 'إرسال'."},
    {"en": "Cancel", "ar": "إلغاء", "category": "core-actions", "notes": "Cancel document."},
    {"en": "Cost Center", "ar": "مركز التكلفة", "category": "accounts", "notes": "Keep (already correct)."},
    {"en": "Chart of Accounts", "ar": "دليل الحسابات", "category": "accounts", "notes": "Keep (already correct)."}
  ]
}
